# P7 reference material — large in-game map screenshots from the maintainer.
# Kept locally for the map phase; not part of the shipped pack.
maps/bg3maps.zip
maps/acts/

# Release-zip output (regenerated on demand by tools/build_release.py).
build/

# Local maintainer config auto-loaded by tools/build_release.py.
# Holds private tokens (e.g. name fragments for the privacy-check
# regex) that must never enter version control. There is intentionally
# no template / example file committed -- writing one would be a leak.
.env

# Debug dumps from tools/generate_pack.py. Resolved pin coordinates +
# overworld centroids -- derived from tools/projections.json and
# tools/pin_overrides.json, not consumed by anything. Inspect-only.
tools/_debug_*.json

# Working directory for the texture renderers (render_region_map.py,
# render_multi_zone_map.py, render_overworld.py, build_texture_index.py).
# Holds the extracted Granite VT DDS cache (~25 GB), preview PNGs, and
# debug intermediates. Re-derivable per MAINTAINER_GUIDE.md.
tools/_texture_work/
